# Every variable is optional; the app builds and runs with none set.
# Copy to .env.local for local development.

# Canonical origin for metadata, sitemap, and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ads render only when this is "true" AND NEXT_PUBLIC_ADSENSE_CLIENT is set.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# Supabase (reviews, submissions, auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MapLibre style URL; defaults to OpenFreeMap "liberty".
NEXT_PUBLIC_MAP_STYLE_URL=

# Used to open issues/PRs from approved submissions (owner/repo).
GITHUB_TOKEN=
GITHUB_REPOSITORY=
